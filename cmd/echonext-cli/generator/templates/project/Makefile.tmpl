# Makefile for {{ .Name }}

.PHONY: help run-api run-worker run-cli build test clean docker-build docker-up docker-down
.PHONY: db-migrate db-migrate-status db-migrate-new db-migrate-diff db-migrate-down db-migrate-lint db-seed

# Default target
help:
	@echo "Available commands:"
	@echo ""
	@echo "Development:"
	@echo "  run-api       - Start API server"
	@echo "  run-worker    - Start background worker"
	@echo "  run-cli       - Run CLI tool"
	@echo "  dev-db        - Start development database"
	@echo ""
	@echo "Build:"
	@echo "  build         - Build all executables"
	@echo "  test          - Run tests"
	@echo "  test-coverage - Run tests with coverage report"
	@echo "  clean         - Clean build artifacts"
	@echo ""
	@echo "Database (Atlas):"
	@echo "  db-migrate        - Apply pending migrations"
	@echo "  db-migrate-status - Show migration status"
	@echo "  db-migrate-new    - Create new migration (NAME=migration_name)"
	@echo "  db-migrate-diff   - Generate migration from schema (NAME=migration_name)"
	@echo "  db-migrate-down   - Rollback last migration"
	@echo "  db-migrate-lint   - Lint migrations for issues"
	@echo "  db-seed           - Seed database with sample data"
	@echo ""
	@echo "Docker:"
	@echo "  docker-build - Build Docker images"
	@echo "  docker-up    - Start services with docker-compose"
	@echo "  docker-down  - Stop services"

# Development
run-api:
	@echo "Starting API server..."
	go run ./cmd/api

run-worker:
	@echo "Starting background worker..."
	go run ./cmd/worker

run-cli:
	@echo "Running CLI..."
	go run ./cmd/cli

# Build
build:
	@echo "Building executables..."
	@mkdir -p bin
	go build -o bin/api ./cmd/api
	go build -o bin/worker ./cmd/worker
	go build -o bin/cli ./cmd/cli
	go build -o bin/migration ./cmd/migration

# Testing
test:
	@echo "Running tests..."
	go test -v ./...

test-coverage:
	@echo "Running tests with coverage..."
	go test -coverprofile=coverage.out ./...
	go tool cover -html=coverage.out -o coverage.html

# Utilities
clean:
	@echo "Cleaning build artifacts..."
	rm -rf bin/
	rm -f coverage.out coverage.html

# Database migrations using Atlas
# Requires: DATABASE_URL environment variable
# Install Atlas: curl -sSf https://atlasgo.sh | sh

db-migrate:
	@echo "Running database migrations..."
	atlas migrate apply --dir file://migrations --env local -c file://atlas.hcl

db-migrate-status:
	@echo "Migration status:"
	atlas migrate status --dir file://migrations --env local -c file://atlas.hcl

db-migrate-new:
ifndef NAME
	$(error NAME is required. Usage: make db-migrate-new NAME=create_users_table)
endif
	@echo "Creating new migration: $(NAME)"
	atlas migrate new $(NAME) --dir file://migrations

db-migrate-diff:
ifndef NAME
	$(error NAME is required. Usage: make db-migrate-diff NAME=add_email_index)
endif
	@echo "Generating migration from schema diff: $(NAME)"
	atlas migrate diff $(NAME) --dir file://migrations --env local -c file://atlas.hcl

db-migrate-down:
	@echo "Rolling back last migration..."
	atlas migrate down 1 --dir file://migrations --env local -c file://atlas.hcl

db-migrate-lint:
	@echo "Linting migrations..."
	atlas migrate lint --dir file://migrations --latest 1 -c file://atlas.hcl

db-migrate-hash:
	@echo "Updating migration checksums..."
	atlas migrate hash --dir file://migrations

db-seed:
	@echo "Seeding database..."
	go run ./cmd/migration seed

# Docker
docker-build:
	@echo "Building Docker images..."
	docker build -f infrastructure/Dockerfile.api -t {{ .Name }}-api .
	docker build -f infrastructure/Dockerfile.worker -t {{ .Name }}-worker .

docker-push:
	@echo "Pushing Docker images..."
	docker push {{ .Name }}-api
	docker push {{ .Name }}-worker

docker-up:
	@echo "Starting services with docker compose..."
	cd infrastructure && docker compose up -d

docker-down:
	@echo "Stopping services..."
	cd infrastructure && docker compose down

# Development database
dev-db:
	@echo "Starting development database..."
	cd infrastructure && docker compose up -d postgres redis
