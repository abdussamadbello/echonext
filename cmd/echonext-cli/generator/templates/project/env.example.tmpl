# Environment Configuration
# Copy this file to .env and update values for your environment

# Application
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/{{ .Name }}_dev?sslmode=disable

# Cache (Redis)
CACHE_ADDRESS=localhost:6379

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME={{ .Name }}
