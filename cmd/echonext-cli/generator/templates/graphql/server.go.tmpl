package main

import (
	"context"
	"log"

	"github.com/99designs/gqlgen/graphql/handler"
	"github.com/99designs/gqlgen/graphql/playground"
	"github.com/abdussamadbello/echonext"
	"{{ .Module }}/graph"
)

func main() {
	app := echonext.New()

	// Create the GraphQL schema
	srv := handler.NewDefaultServer(graph.NewExecutableSchema(graph.Config{
		Resolvers: graph.NewResolver(),
	}))

	// Using EchoNext's GraphQL integration
	app.GraphQL(echonext.GraphQLConfig{
		Path:           "/graphql",
		PlaygroundPath: "/playground",
		Schema:         graph.NewExecutableSchema(graph.Config{
			Resolvers: graph.NewResolver(),
		}),
	})

	// OR: Use Echo's handler wrapping directly
	// app.Echo.POST("/graphql", echo.WrapHandler(srv))
	// app.Echo.GET("/playground", echo.WrapHandler(playground.Handler("GraphQL", "/graphql")))

	log.Println("Starting server on :8080")
	log.Println("GraphQL Playground: http://localhost:8080/playground")

	if err := app.Start(":8080"); err != nil {
		log.Fatal(err)
	}
}

